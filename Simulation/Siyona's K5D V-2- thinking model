## Self-Correction (when given action result)
If you receive an action result that shows failure:
- Re-read the world state
- Identify the root cause
- Emit a corrected plan
- Do not repeat the same failed action without adjusting approach
"""


class Planner:
    MAX_REPLAN_ATTEMPTS = 3

    def __init__(self, world: WorldModel, memory: Memory, validator: Validator,
                 api_key: str = ""):
        self.world = world
        self.memory = memory
        self.validator = validator
        self.api_key = api_key
        self.conversation_history: List[Dict] = []

    def _call_api(self, messages: List[Dict]) -> str:
        payload = json.dumps({
            "model": ANTHROPIC_MODEL,
            "max_tokens": 1500,
            "system": SYSTEM_PROMPT,
            "messages": messages
        }).encode("utf-8")

        headers = {
            "Content-Type": "application/json",
            "x-api-key": self.api_key,
            "anthropic-version": "2023-06-01"
        }

        req = urllib.request.Request(
            ANTHROPIC_API_URL,
            data=payload,
            headers=headers,
            method="POST"
        )
        with urllib.request.urlopen(req, timeout=45) as resp:
            data = json.loads(resp.read())

        # Handle content blocks
        content = data.get("content", [])
        return "".join(
            block.get("text", "") for block in content
            if block.get("type") == "text"
        )

    def _build_context_message(self, user_goal: str,
                                action_results: List[Dict] = None) -> str:
        scene = self.world.describe_scene()
        mem_ctx = self.memory.context_for_planner()

        parts = [
            f"## World State\n{scene}",
            f"## Memory\n{mem_ctx}",
            f"## Goal\n{user_goal}",
        ]

        if action_results:
            results_text = "\n".join(
                f"  Step {r['step']}: {r['command']} → "
                f"{'✅ OK' if r.get('success') else '❌ FAILED: ' + r.get('error','?')}"
                for r in action_results
            )
            parts.append(f"## Previous Action Results\n{results_text}")
            parts.append(
                "Some steps failed. Re-observe the world state above, "
                "identify the root cause, and emit a corrected plan."
            )

        return "\n\n".join(parts)

    def plan(self, user_goal: str,
             action_results: List[Dict] = None,
             reset_conversation: bool = False) -> Dict:
        """
        Generate a command plan for the given goal.
        Returns {"commands": [...], "raw_reply": str, "validation": {...}}
        """
        if reset_conversation:
            self.conversation_history = []

        self.memory.set_goal(user_goal)
        self.memory.record("observation", self.world.describe_scene())

        context_msg = self._build_context_message(user_goal, action_results)
        self.conversation_history.append({"role": "user", "content": context_msg})

        raw_reply = self._call_api(self.conversation_history)
        self.conversation_history.append({"role": "assistant", "content": raw_reply})

        # Extract commands from {…} blocks
        commands = [m.group(1).strip()
                    for m in __import__("re").finditer(r'\{([^}]+)\}', raw_reply)]

        validation = self.validator.validate_plan(commands)

        return {
            "commands": validation["valid_commands"],
            "all_commands": commands,
            "raw_reply": raw_reply,
            "validation": validation
        }

    def replan(self, user_goal: str,
               failed_results: List[Dict]) -> Dict:
        """Replan after partial or total failure."""
        attempts = self.memory.recent_failures_for_goal()
        if attempts >= self.MAX_REPLAN_ATTEMPTS:
            return {
                "commands": [],
                "error": f"Max replan attempts ({self.MAX_REPLAN_ATTEMPTS}) reached",
                "aborted": True
            }
        self.memory.record("failure", f"Replanning for: {user_goal}")
        return self.plan(user_goal, action_results=failed_results,
                        reset_conversation=False)

    def reset(self):
        self.conversation_history = []


# ─────────────────────────────────────────────
# EXECUTOR  (structured feedback)
# ─────────────────────────────────────────────

class Executor:
    """
    The executor doesn't physically run commands — those are animations in
    the browser. Instead it:
      1. Validates each command before sending to client
      2. Records structured results returned from client
      3. Updates the world model after each action
      4. Detects mismatches between expected and actual state
    """

    def __init__(self, world: WorldModel, memory: Memory, validator: Validator):
        self.world = world
        self.memory = memory
        self.validator = validator

    def pre_execute(self, commands: List[str]) -> Dict:
        """Pre-execution validation pass. Returns filtered commands + report."""
        validation = self.validator.validate_plan(commands)
        return {
            "commands": validation["valid_commands"],
            "skipped": [c for c in commands
                        if c not in validation["valid_commands"]],
            "errors": validation["errors"],
            "warnings": validation["warnings"],
        }

    def process_action_result(self, command: str, result: Dict,
                               step: int) -> Dict:
        """Process a single action result from client. Update world model."""
        success = result.get("success", False)
        client_state = result.get("world_state")

        record = {
            "step": step,
            "command": command,
            "success": success,
            "error": result.get("error"),
            "object": result.get("object"),
        }

        # Sync world model
        if client_state:
            self.world.sync_from_client(client_state)

        # Apply semantic updates based on command semantics
        if success:
            cmd_lower = command.lower()

            if any(cmd_lower.startswith(p) for p in
                   ("pickup", "pickup_from_side", "pickup_from_spoon")):
                # Mark held object
                if result.get("held_object_id"):
                    self.world.held_object_id = result["held_object_id"]
                    if self.world.held_object_id in self.world.objects:
                        self.world.objects[self.world.held_object_id].held_by_robot = True

            elif any(cmd_lower.startswith(p) for p in ("keep", "keep_from_spoon")):
                if self.world.held_object_id and self.world.held_object_id in self.world.objects:
                    obj = self.world.objects[self.world.held_object_id]
                    obj.held_by_robot = False
                    obj.location = self.world.robot_location
                self.world.held_object_id = None
                self.world.gripper_open = True

            elif cmd_lower == "pour":
                if self.world.held_object_id and self.world.held_object_id in self.world.objects:
                    self.world.objects[self.world.held_object_id].filled = False

            elif cmd_lower == "press":
                self.world.pressed = True

            elif cmd_lower == "un_press":
                self.world.pressed = False

            elif cmd_lower == "wait":
                pass  # no state change

        self.memory.record_action(command, record)
        return record

    def verify_post_action(self, command: str, expected_state: Dict,
                            actual_state: Dict) -> Dict:
        """Compare expected vs actual state. Returns mismatch report."""
        mismatches = []

        if "held_object" in expected_state:
            exp_held = expected_state["held_object"]
            act_held = actual_state.get("held_object_id")
            if exp_held and not act_held:
                mismatches.append("Expected to hold object but gripper is empty")
            elif not exp_held and act_held:
                mismatches.append("Expected empty gripper but object is still held")

        if "robot_location" in expected_state:
            if actual_state.get("robot_location") != expected_state["robot_location"]:
                mismatches.append(
                    f"Expected robot at {expected_state['robot_location']} "
                    f"but at {actual_state.get('robot_location')}"
                )

        return {
            "verified": len(mismatches) == 0,
            "mismatches": mismatches
        }


