# Global agent state (module-level singletons)
world_model = WorldModel()
memory      = Memory()
validator   = Validator(world_model)
planner     = None   # Initialized after API key is known


def get_planner(api_key: str) -> Planner:
    global planner
    if planner is None or planner.api_key != api_key:
        planner = Planner(world_model, memory, validator, api_key)
    return planner


executor = Executor(world_model, memory, validator)


class K5DHandler(BaseHTTPRequestHandler):
    """
    Routes:
      GET  /          → serve HTML simulator
      POST /api/chat  → plan + replan loop
      POST /api/sync  → client pushes world state after actions
      POST /api/object/add    → add object to world model
      POST /api/object/remove → remove object from world model
      POST /api/object/rename → rename object in world model
      POST /api/action/result → structured action result from client
      GET  /api/world         → dump current world model as JSON
      GET  /api/memory        → dump memory as JSON
    """

    def _send_json(self, data: Dict, status: int = 200):
        body = json.dumps(data).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()
        self.wfile.write(body)

    def _send_html(self, html: str):
        body = html.encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _read_json(self) -> Dict:
        length = int(self.headers.get("Content-Length", 0))
        return json.loads(self.rfile.read(length))

    def do_OPTIONS(self):
        self.send_response(200)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.end_headers()

    def do_GET(self):
        if self.path == "/" or self.path == "/index.html":
            self._send_html(HTML)
        elif self.path == "/api/world":
            self._send_json(world_model.observe())
        elif self.path == "/api/memory":
            self._send_json({
                "active_goal": memory.active_goal,
                "completed_tasks": memory.completed_tasks,
                "failed_attempts": memory.failed_attempts[-10:],
                "recent_entries": [
                    {"kind": e.kind, "content": e.content,
                     "timestamp": e.timestamp}
                    for e in memory.entries[-30:]
                ]
            })
        else:
            self.send_response(404)
            self.end_headers()

    def do_POST(self):
        try:
            if self.path == "/api/chat":
                self._handle_chat()
            elif self.path == "/api/sync":
                self._handle_sync()
            elif self.path == "/api/object/add":
                self._handle_object_add()
            elif self.path == "/api/object/remove":
                self._handle_object_remove()
            elif self.path == "/api/object/rename":
                self._handle_object_rename()
            elif self.path == "/api/action/result":
                self._handle_action_result()
            else:
                self.send_response(404)
                self.end_headers()
        except Exception as e:
            self._send_json({"error": str(e)}, 500)

    def _handle_chat(self):
        body = self._read_json()
        user_text   = body.get("message", "")
        api_key     = body.get("api_key", "")
        client_state = body.get("world_state")
        replan_results = body.get("replan_results")  # None for fresh plan

        if not user_text:
            self._send_json({"error": "empty message"}, 400)
            return

        # Sync world state from client before planning
        if client_state:
            world_model.sync_from_client(client_state)
            memory.record("observation", world_model.describe_scene())

        p = get_planner(api_key)

        try:
            if replan_results:
                result = p.replan(user_text, replan_results)
            else:
                result = p.plan(user_text, reset_conversation=True)
        except Exception as e:
            memory.fail_goal(str(e))
            self._send_json({"error": str(e), "commands": []}, 500)
            return

        # Pre-execution validation
        pre = executor.pre_execute(result["commands"])

        self._send_json({
            "commands":   pre["commands"],
            "skipped":    pre["skipped"],
            "errors":     pre["errors"],
            "warnings":   pre["warnings"],
            "raw_reply":  result.get("raw_reply", ""),
            "goal_id":    memory.active_goal_id,
        })

    def _handle_sync(self):
        body = self._read_json()
        world_model.sync_from_client(body)
        self._send_json({"ok": True, "world": world_model.observe()})

    def _handle_object_add(self):
        body = self._read_json()
        oid = world_model.add_object(
            type=body.get("type", "unknown"),
            location=body.get("location", "A1"),
            display_name=body.get("display_name", ""),
            metadata=body.get("metadata", {})
        )
        memory.record("observation", f"New object added: {body.get('type')} at {body.get('location')}")
        self._send_json({"ok": True, "id": oid})

    def _handle_object_remove(self):
        body = self._read_json()
        oid = body.get("id")
        if oid:
            world_model.remove_object(oid)
            memory.record("observation", f"Object removed: {oid}")
        self._send_json({"ok": True})

    def _handle_object_rename(self):
        body = self._read_json()
        oid = body.get("id")
        name = body.get("name", "")
        if oid and name:
            world_model.rename_object(oid, name)
        self._send_json({"ok": True})

    def _handle_action_result(self):
        body = self._read_json()
        command = body.get("command", "")
        result  = body.get("result", {})
        step    = body.get("step", 0)
        record  = executor.process_action_result(command, result, step)
        self._send_json({"ok": True, "record": record})

    def log_message(self, format, *args):
        pass  # suppress HTTP access logs


