function showExecLog(commands) {
  const logDiv=document.getElementById('exec-log');
  const entries=document.getElementById('exec-log-entries');
  logDiv.style.display='block'; entries.innerHTML='';
  commands.forEach((cmd,i)=>{
    const div=document.createElement('div');
    div.id=`cmd-entry-${i}`; div.className='cmd-log-entry cmd-pending';
    div.textContent=`${i+1}. ${cmd}`;
    entries.appendChild(div);
  });
}
function markCmd(i, cls) {
  const el=document.getElementById(`cmd-entry-${i}`);
  if(el){ el.className='cmd-log-entry '+cls; el.scrollIntoView({block:'nearest'}); }
}
function updateProgress(done,total) {
  document.getElementById('task-progress').classList.remove('hidden');
  document.getElementById('task-step-counter').textContent=`${done}/${total}`;
  document.getElementById('task-progress-bar').style.width=total>0?`${(done/total)*100}%`:'0%';
}
function hideProgress() {
  document.getElementById('task-progress').classList.add('hidden');
  document.getElementById('exec-log').style.display='none';
}

// Returns array of {step, command, success, error}
async function executeCommands(commands) {
  const results = [];
  showExecLog(commands);
  updateProgress(0, commands.length);

  for(let i=0;i<commands.length;i++) {
    if(cancelRequested) {
      results.push({step:i+1, command:commands[i], success:false, error:'cancelled'});
      break;
    }
    const raw=commands[i].trim();
    const rawLower=raw.toLowerCase();
    markCmd(i,'cmd-active');
    updateProgress(i, commands.length);
    setPhase(`Step ${i+1}/${commands.length}: ${raw.substring(0,40)}`);

    let result = {success:true, error:null};

    try {
      if(rawLower.includes('goto_coordinate')) {
        const parts=raw.split('=').slice(1).join('=').replace(/[()]/g,'').trim().split(',');
        if(parts.length>=2) await moveTo(parts[0].trim(), parts[1].trim());
        else result={success:false,error:'bad_coord_format'};

      } else if(rawLower==='pickup') {
        result=await pickup();

      } else if(rawLower==='pickup_from_side') {
        result=await pickupFromSide();

      } else if(rawLower==='pickup_from_spoon') {
        result=await pickupFromSpoon();

      } else if(rawLower==='keep') {
        result=await placeDown();

      } else if(rawLower==='keep_from_spoon') {
        result=await keepFromSpoon();

      } else if(rawLower==='pour') {
        result=await pourAction();

      } else if(rawLower.startsWith('apply_soap')) {
        const coordStr=raw.replace(/apply_soap/i,'').replace(/[()=]/g,' ').trim();
        const coordTokens=coordStr.split(',').map(s=>s.trim()).filter(Boolean);
        for(const token of coordTokens) {
          const parsed=parseCoord(token);
          if(parsed) await applySoapAtCoord(parsed.col,parsed.row);
        }

      } else if(rawLower.startsWith('apply_cloth')) {
        const coordStr=raw.replace(/apply_cloth/i,'').replace(/[()=]/g,' ').trim();
        const coordTokens=coordStr.split(',').map(s=>s.trim()).filter(Boolean);
        for(const token of coordTokens) {
          const parsed=parseCoord(token);
          if(parsed) await applyClothAtCoord(parsed.col,parsed.row);
        }

      } else if(rawLower==='press') {
        result=await pressAction();

      } else if(rawLower==='press_from_side') {
        result=await pressFromSideAction();

      } else if(rawLower==='un_press') {
        result=await unPressAction();

      } else if(rawLower.startsWith('drag')) {
        const argStr=raw.replace(/drag/i,'').replace(/[()=]/g,' ').trim();
        const direction=argStr.split(',').pop().trim();
        result=await dragAction(direction);

      } else if(rawLower.startsWith('rotate_ccw')) {
        const argStr=raw.replace(/rotate_ccw/i,'').replace(/[()=]/g,' ').trim();
        result=await rotateCCWAction(parseFloat(argStr)||90);

      } else if(rawLower.startsWith('rotate')) {
        const argStr=raw.replace(/rotate/i,'').replace(/[()=]/g,' ').trim();
        result=await rotateAction(parseFloat(argStr)||90);

      } else if(rawLower.startsWith('change_orientation')) {
        const argStr=raw.replace(/change_orientation(_xy)?/i,'').replace(/[()=]/g,' ').trim();
        const parts=argStr.split(',').map(s=>parseFloat(s.trim()));
        result=await changeOrientationAction(parts[0]||0,parts[1]||0);

      } else if(rawLower==='wait') {
        result=await waitAction();

      } else if(rawLower==='task_completed') {
        markCmd(i,'cmd-done');
        results.push({step:i+1,command:raw,success:true});
        updateProgress(commands.length,commands.length);
        break;

      } else {
        result={success:false,error:`unknown_command: ${raw}`};
      }
    } catch(err) {
      result={success:false,error:err.message};
    }

    markCmd(i, result.success ? 'cmd-done' : 'cmd-error');
    results.push({step:i+1, command:raw, success:result.success, error:result.error});
    await reportActionResult(raw, result.success, i+1, result.error);
    await delay(80);
  }

  updateProgress(commands.length, commands.length);
  return results;
}

