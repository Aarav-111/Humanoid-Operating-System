window.sendTask = async function() {
  if(!API_KEY) { appendMessage('assistant','⚠️ Please enter your Anthropic API key above first.'); return; }
  const input=document.getElementById('chat-input');
  const text=input.value.trim();
  if(!text||executionActive) return;
  input.value='';
  input.disabled=true;
  document.getElementById('chat-send-btn').disabled=true;
  document.getElementById('chat-cancel-btn').classList.remove('hidden');
  executionActive=true; cancelRequested=false;
  document.getElementById('ai-status-dot').className='ml-auto w-2 h-2 bg-blue-400 rounded-full animate-pulse';
  appendMessage('user', text);
  document.getElementById('task-progress').classList.remove('hidden');

  const MAX_REPLAN = 2;
  let planResult = null;
  let failedResults = null;
  let attempts = 0;

  while(attempts <= MAX_REPLAN && !cancelRequested) {
    attempts++;
    // OBSERVE → THINK → PLAN
    appendThinking(attempts===1 ? '🔭 Observing board · reasoning · planning…' : `🔄 Replanning (attempt ${attempts})…`);
    setPhase('Planning…');

    let planResponse;
    try {
      planResponse = await fetch('/api/chat', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body:JSON.stringify({
          message: text,
          api_key: API_KEY,
          world_state: getWorldState(),
          replan_results: failedResults || null,
        })
      });
      if(!planResponse.ok) throw new Error(`Server error ${planResponse.status}`);
      planResult = await planResponse.json();
    } catch(err) {
      document.getElementById('thinking-bubble')?.remove();
      appendMessage('assistant','❌ Planning error: '+err.message);
      break;
    }

    document.getElementById('thinking-bubble')?.remove();

    if(planResult.error) {
      appendMessage('assistant','❌ '+planResult.error);
      break;
    }

    // Show validation warnings
    if(planResult.errors?.length) {
      appendMessage('assistant','⚠️ Validation skipped '+planResult.errors.length+' invalid command(s):<br>'+
        planResult.errors.map(e=>`<span class="text-rose-400">${e}</span>`).join('<br>'));
    }
    if(planResult.warnings?.length) {
      appendMessage('assistant','💡 Warnings: '+planResult.warnings.join('; '));
    }

    const commands = planResult.commands || [];
    if(!commands.length) {
      appendMessage('assistant','⚠️ No executable commands generated. Try rephrasing the task.');
      break;
    }

    // Show plan
    const planText=commands.map((c,i)=>`${i+1}. ${c}`).join('\n');
    appendMessage('assistant',`📋 <strong>${commands.length}-step plan:</strong><pre class="text-xs mt-1 text-emerald-400 whitespace-pre-wrap">${planText}</pre>`);

    // ACT
    setStatus(`<span class="w-2 h-2 bg-blue-400 rounded-full inline-block animate-pulse"></span>&nbsp;Executing…`);
    const results = await executeCommands(commands);

    // VERIFY
    const failed = results.filter(r=>!r.success && r.error !== 'cancelled');
    const cancelled = results.some(r=>r.error==='cancelled');

    if(cancelled) break;

    if(failed.length===0) {
      // SUCCESS
      appendMessage('assistant','✅ <strong>Task complete!</strong> All steps executed successfully.');
      setStatus('<span class="w-2 h-2 bg-emerald-400 rounded-full inline-block animate-pulse"></span>&nbsp;Task complete');
      await serverSync();
      break;
    } else {
      // REPLAN
      const failSummary=failed.map(r=>`Step ${r.step} "${r.command}": ${r.error}`).join('; ');
      appendMessage('assistant',`⚠️ <strong>${failed.length} step(s) failed:</strong> ${failSummary}`);

      if(attempts>MAX_REPLAN) {
        appendMessage('assistant','❌ Max replan attempts reached. Please check object positions and try again.');
        setStatus('⚠️ Task failed after replanning');
        break;
      }

      failedResults=results;
      // Brief pause before replanning
      await delay(600);
    }
  }

  executionActive=false; cancelRequested=false;
  input.disabled=false;
  document.getElementById('chat-send-btn').disabled=false;
  document.getElementById('chat-cancel-btn').classList.add('hidden');
  document.getElementById('ai-status-dot').className='ml-auto w-2 h-2 bg-emerald-400 rounded-full';
  setTimeout(hideProgress,3000);
  await serverSync();
  input.focus();
};

