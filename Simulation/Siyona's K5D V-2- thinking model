# VALIDATOR
# ─────────────────────────────────────────────

VALID_GRID_COLS = set("ABCDEFGHIJKLMNOPQRST")
VALID_GRID_ROWS = set(range(1, 12))  # 1-11

KNOWN_COMMANDS = {
    "goto_coordinate", "pickup", "pickup_from_side", "pickup_from_spoon",
    "keep", "keep_from_spoon", "pour", "press", "press_from_side",
    "un_press", "drag", "rotate", "rotate_ccw", "change_orientation",
    "change_orientation_xy", "wait", "apply_soap", "apply_cloth",
    "task_completed",
}

class Validator:
    def __init__(self, world: WorldModel):
        self.world = world

    def validate_command(self, raw: str) -> Dict:
        """Returns {"valid": bool, "command": str, "args": [...], "error": str}"""
        raw = raw.strip()
        cmd_lower = raw.lower()

        # Extract command name
        cmd_name = cmd_lower.split("=")[0].split("(")[0].strip()

        if cmd_name not in KNOWN_COMMANDS:
            return {"valid": False, "command": raw,
                    "error": f"Unknown command: '{cmd_name}'"}

        # Validate goto_coordinate
        if cmd_name == "goto_coordinate":
            parts = raw.split("=", 1)
            if len(parts) < 2:
                return {"valid": False, "command": raw,
                        "error": "goto_coordinate missing = COL, ROW"}
            coord_part = parts[1].strip()
            tokens = [t.strip().upper() for t in coord_part.split(",")]
            if len(tokens) < 2:
                return {"valid": False, "command": raw,
                        "error": "goto_coordinate needs COL and ROW"}
            col, row_s = tokens[0], tokens[1]
            if col not in VALID_GRID_COLS:
                return {"valid": False, "command": raw,
                        "error": f"Column '{col}' out of range (A-T)"}
            try:
                row = int(row_s)
                if row not in VALID_GRID_ROWS:
                    raise ValueError()
            except ValueError:
                return {"valid": False, "command": raw,
                        "error": f"Row '{row_s}' out of range (1-11)"}
            return {"valid": True, "command": cmd_name,
                    "args": [col, str(row)], "error": None}

        # Validate pickup when nothing is there
        if cmd_name in ("pickup", "pickup_from_side", "pickup_from_spoon"):
            loc = self.world.robot_location
            objs = self.world.get_objects_at(loc)
            if not objs and not self.world.held_object_id:
                return {"valid": True, "command": cmd_name, "args": [],
                        "error": None,
                        "warning": f"No object found at {loc} — pickup may fail"}
            return {"valid": True, "command": cmd_name, "args": [], "error": None}

        # Validate place requires held object
        if cmd_name in ("keep", "keep_from_spoon"):
            if not self.world.held_object_id:
                return {"valid": False, "command": raw,
                        "error": "Cannot place — robot not holding any object"}
            return {"valid": True, "command": cmd_name, "args": [], "error": None}

        # Validate pour
        if cmd_name == "pour":
            if not self.world.held_object_id:
                loc = self.world.robot_location
                objs = self.world.get_objects_at(loc)
                if not objs:
                    return {"valid": False, "command": raw,
                            "error": "Cannot pour — not holding object and none at current cell"}
            return {"valid": True, "command": cmd_name, "args": [], "error": None}

        # Validate drag direction
        if cmd_name == "drag":
            arg_str = raw.lower().replace("drag", "").replace("(", "").replace(")", "").strip()
            direction = arg_str.split(",")[-1].strip()
            valid_dirs = {"left", "right", "forward", "backward", "in", "out"}
            if direction not in valid_dirs:
                return {"valid": False, "command": raw,
                        "error": f"Invalid drag direction '{direction}'. Use: {valid_dirs}"}
            return {"valid": True, "command": cmd_name,
                    "args": [direction], "error": None}

        # Validate rotate angles
        if cmd_name in ("rotate", "rotate_ccw"):
            arg_str = raw.replace(cmd_name, "").replace("(", "").replace(")", "").strip()
            try:
                angle = float(arg_str) if arg_str else 90.0
                if not (0 < abs(angle) <= 360):
                    return {"valid": False, "command": raw,
                            "error": f"Rotation angle {angle}° out of range (0-360)"}
            except ValueError:
                return {"valid": False, "command": raw,
                        "error": f"Invalid rotation angle '{arg_str}'"}
            return {"valid": True, "command": cmd_name,
                    "args": [str(angle)], "error": None}

        # Validate apply_soap / apply_cloth coords
        if cmd_name in ("apply_soap", "apply_cloth"):
            arg_str = (raw.replace(cmd_name, "")
                         .replace("Apply_soap", "").replace("Apply_cloth", "")
                         .replace("(", "").replace(")", "").strip())
            coords = [c.strip().upper() for c in arg_str.split(",") if c.strip()]
            invalid = []
            for coord in coords:
                if len(coord) < 2:
                    invalid.append(coord); continue
                col = coord[0]
                row_s = coord[1:]
                if col not in VALID_GRID_COLS:
                    invalid.append(coord); continue
                try:
                    if int(row_s) not in VALID_GRID_ROWS:
                        invalid.append(coord)
                except ValueError:
                    invalid.append(coord)
            if invalid:
                return {"valid": False, "command": raw,
                        "error": f"Invalid coordinates in {cmd_name}: {invalid}"}
            return {"valid": True, "command": cmd_name,
                    "args": coords, "error": None}

        # All other known commands pass through
        return {"valid": True, "command": cmd_name, "args": [], "error": None}

    def validate_plan(self, commands: List[str]) -> Dict:
        """Validate an entire plan. Returns errors list and filtered valid commands."""
        errors = []
        valid_commands = []
        warnings = []

        for i, cmd in enumerate(commands):
            result = self.validate_command(cmd)
            if not result["valid"]:
                errors.append(f"Step {i+1}: {result['error']}")
            else:
                valid_commands.append(cmd)
                if result.get("warning"):
                    warnings.append(f"Step {i+1}: {result['warning']}")

        return {
            "errors": errors,
            "warnings": warnings,
            "valid_commands": valid_commands,
            "has_task_completed": any(
                "task_completed" in c.lower() for c in commands
            )
        }


