@dataclass
class WorldObject:
    id: str
    type: str
    location: str          # grid coord e.g. "A1"
    orientation: Dict      # {"x": 0, "y": 0, "z": 0}
    held_by_robot: bool    = False
    contains: List[str]    = field(default_factory=list)   # ids of objects inside
    inside: Optional[str]  = None                          # id of container this is in
    on_top_of: Optional[str] = None
    clean: bool            = True
    open: bool             = True
    filled: bool           = False
    metadata: Dict         = field(default_factory=dict)
    display_name: str      = ""

    def to_dict(self):
        d = asdict(self)
        d["display_name"] = self.display_name or self.type
        return d

    def describe(self) -> str:
        parts = [f"{self.display_name or self.type} at {self.location}"]
        if self.held_by_robot:
            parts.append("(held)")
        if self.contains:
            parts.append(f"contains: {self.contains}")
        if self.inside:
            parts.append(f"inside: {self.inside}")
        if not self.clean:
            parts.append("dirty")
        if not self.open:
            parts.append("closed")
        if self.filled:
            parts.append("filled")
        return ", ".join(parts)


class WorldModel:
    def __init__(self):
        self.objects: Dict[str, WorldObject] = {}
        self.robot_location: str = "A1"
        self.robot_z: float = 4.0
        self.gripper_open: bool = True
        self.held_object_id: Optional[str] = None
        self.pressed: bool = False
        self.orientation_x: float = 0.0
        self.orientation_y: float = 0.0
        self.last_updated: float = time.time()

    def add_object(self, type: str, location: str,
                   display_name: str = "", metadata: Dict = None) -> str:
        oid = str(uuid.uuid4())[:8]
        obj = WorldObject(
            id=oid,
            type=type,
            location=location,
            orientation={"x": 0, "y": 0, "z": 0},
            display_name=display_name or type,
            metadata=metadata or {}
        )
        self.objects[oid] = obj
        self.last_updated = time.time()
        return oid

    def remove_object(self, oid: str):
        if oid == self.held_object_id:
            self.held_object_id = None
            self.gripper_open = True
        self.objects.pop(oid, None)
        self.last_updated = time.time()

    def rename_object(self, oid: str, new_name: str):
        if oid in self.objects:
            self.objects[oid].display_name = new_name
            self.last_updated = time.time()

    def get_objects_at(self, location: str) -> List[WorldObject]:
        return [o for o in self.objects.values()
                if o.location == location and not o.held_by_robot]

    def get_object_by_type(self, type_hint: str) -> Optional[WorldObject]:
        """Fuzzy match by type or display_name."""
        type_hint = type_hint.lower()
        for o in self.objects.values():
            if (type_hint in o.type.lower() or
                    type_hint in o.display_name.lower()):
                return o
        return None

    def find_alternatives(self, type_hint: str) -> List[WorldObject]:
        """Find functionally similar objects for tool discovery."""
        ALIASES = {
            "watering_can": ["bottle", "water_cup", "glass"],
            "water":        ["water_cup", "bottle", "glass"],
            "cloth":        ["book"],           # flat objects can wipe
            "container":    ["bottle", "water_cup", "glass", "mug", "box"],
            "liquid":       ["water_cup", "bottle", "glass"],
        }
        candidates = ALIASES.get(type_hint.lower(), [])
        result = []
        for c in candidates:
            obj = self.get_object_by_type(c)
            if obj:
                result.append(obj)
        return result

    def observe(self) -> Dict:
        """Return full world snapshot for planner context."""
        return {
            "robot_location": self.robot_location,
            "robot_z": self.robot_z,
            "gripper_open": self.gripper_open,
            "held_object": (self.objects[self.held_object_id].to_dict()
                            if self.held_object_id and
                            self.held_object_id in self.objects else None),
            "pressed": self.pressed,
            "orientation": {"x": self.orientation_x, "y": self.orientation_y},
            "objects": [o.to_dict() for o in self.objects.values()],
            "timestamp": self.last_updated,
        }

    def describe_scene(self) -> str:
        """Human-readable scene description for planner prompt."""
        lines = [
            f"Robot at {self.robot_location}, Z={self.robot_z:.1f}",
            f"Gripper: {'OPEN' if self.gripper_open else 'CLOSED'}",
            f"Holding: {self.objects[self.held_object_id].display_name if self.held_object_id and self.held_object_id in self.objects else 'nothing'}",
            f"Pressed: {self.pressed}",
            f"Orientation: ({self.orientation_x:.0f}°, {self.orientation_y:.0f}°)",
            "",
            "Objects on board:",
        ]
        for o in self.objects.values():
            lines.append(f"  - {o.describe()}")
        return "\n".join(lines)

    def sync_from_client(self, client_state: Dict):
        """Sync world model from client-reported state after each action."""
        self.robot_location = client_state.get("robot_location", self.robot_location)
        self.robot_z = client_state.get("robot_z", self.robot_z)
        self.gripper_open = client_state.get("gripper_open", self.gripper_open)
        self.pressed = client_state.get("pressed", self.pressed)
        self.orientation_x = client_state.get("orientation_x", self.orientation_x)
        self.orientation_y = client_state.get("orientation_y", self.orientation_y)
        self.held_object_id = client_state.get("held_object_id")

        # Sync object locations reported by client
        for obj_update in client_state.get("objects", []):
            oid = obj_update.get("id")
            if oid and oid in self.objects:
                self.objects[oid].location = obj_update.get("location",
                    self.objects[oid].location)
                self.objects[oid].held_by_robot = (oid == self.held_object_id)

        self.last_updated = time.time()


