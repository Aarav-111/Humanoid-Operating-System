function dragAction(direction) {
  return new Promise(resolve=>{
    let dx=0,dy=0;
    switch((direction||'').toLowerCase()) {
      case 'left':     dx=-1; break;
      case 'right':    dx=1;  break;
      case 'forward': case 'out': dy=1; break;
      case 'backward': case 'in': dy=-1; break;
    }
    const target=heldObject||getObjectAtCurrentCell();
    isAnimating=true;
    animateZ(currentZ,5.6,350,()=>{
      const newX=Math.max(0,Math.min(GRID_WIDTH-1,Math.round(currentX)+dx));
      const newY=Math.max(0,Math.min(GRID_HEIGHT-1,Math.round(currentY)+dy));
      animateXY(newX,newY,450,()=>{
        if(target){
          target.position.x=newX+0.5; target.position.z=newY+0.5;
          if(target!==heldObject) target.position.y=0.5;
          const sprite=objectSprites.get(target);
          if(sprite){ sprite.position.x=target.position.x; sprite.position.z=target.position.z; sprite.position.y=target.position.y+2.2; }
        }
        animateZ(currentZ,4.0,300,()=>{ isAnimating=false; resolve({success:true}); });
      });
    });
  });
}
function rotateAction(angleDeg) {
  return new Promise(resolve=>{
    const deg=isNaN(angleDeg)?90:angleDeg;
    isAnimating=true;
    const steps=24; let step=0;
    const startRot=gripperMount.rotation.y, endRot=startRot+(deg*Math.PI/180);
    const tick=()=>{
      step++;
      const t=step/steps;
      gripperMount.rotation.y=startRot+(endRot-startRot)*t;
      if(heldObject) heldObject.rotation.y=gripperMount.rotation.y;
      if(step<steps) requestAnimationFrame(tick);
      else { isAnimating=false; resolve({success:true}); }
    };
    requestAnimationFrame(tick);
  });
}
function rotateCCWAction(angleDeg) {
  const deg=isNaN(angleDeg)?90:angleDeg;
  return rotateAction(-deg);
}
function changeOrientationAction(xDeg,yDeg) {
  return new Promise(resolve=>{
    const tx=isNaN(xDeg)?0:xDeg, ty=isNaN(yDeg)?0:yDeg;
    isAnimating=true;
    const steps=24; let step=0;
    const startX=gripperMount.rotation.x, startZ=gripperMount.rotation.z;
    const endX=tx*Math.PI/180, endZ=ty*Math.PI/180;
    const tick=()=>{
      step++;
      const t=step/steps;
      gripperMount.rotation.x=startX+(endX-startX)*t;
      gripperMount.rotation.z=startZ+(endZ-startZ)*t;
      if(heldObject){ heldObject.rotation.x=gripperMount.rotation.x; heldObject.rotation.z=gripperMount.rotation.z; }
      if(step<steps) requestAnimationFrame(tick);
      else {
        orientationX=tx; orientationY=ty; setOrientationDisplay();
        isAnimating=false; resolve({success:true});
      }
    };
    requestAnimationFrame(tick);
  });
}
function waitAction() {
  return new Promise(resolve=>{
    setStatus('⏳ Waiting…');
    setTimeout(()=>{ resolve({success:true}); },1000);
  });
}

function applySoapAtCoord(col,row) {
  return new Promise(async resolve=>{
    await moveTo(col,row);
    isAnimating=true;
    animateZ(currentZ,5.5,400,()=>{
      setTimeout(()=>{ animateZ(currentZ,3.0,350,()=>{ isAnimating=false; resolve({success:true}); }); },300);
    });
  });
}
function applyClothAtCoord(col,row) {
  return new Promise(async resolve=>{
    await moveTo(col,row);
    isAnimating=true;
    animateZ(currentZ,5.5,400,()=>{
      const baseX=currentX,baseY=currentY;
      const WIPE_STEPS=4,WIPE_AMP=0.3;
      let wipeStep=0;
      function doWipe() {
        if(wipeStep>=WIPE_STEPS) {
          animateXY(baseX,baseY,150,()=>{
            animateZ(currentZ,3.0,350,()=>{ isAnimating=false; resolve({success:true}); });
          });
          return;
        }
        const offset=(wipeStep%2===0)?WIPE_AMP:-WIPE_AMP;
        animateXY(baseX+offset,baseY,120,()=>{ wipeStep++; doWipe(); });
      }
      doWipe();
    });
  });
}

function delay(ms){ return new Promise(r=>setTimeout(r,ms)); }

