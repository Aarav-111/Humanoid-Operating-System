  const wrap=document.createElement('div');
  wrap.className='flex gap-2'+(role==='user'?' justify-end':'');
  if(role==='assistant') {
    wrap.innerHTML='<div class="w-5 h-5 bg-blue-600 rounded-md flex items-center justify-center text-white text-xs font-bold shrink-0 mt-0.5">AI</div>'+
      '<div class="bg-zinc-800 rounded-xl rounded-tl-sm px-3 py-2 text-xs text-zinc-300 leading-relaxed max-w-xs">'+html+'</div>';
  } else {
    wrap.innerHTML='<div class="bg-blue-600 rounded-xl rounded-tr-sm px-3 py-2 text-xs text-white leading-relaxed max-w-xs">'+html+'</div>';
  }
  box.appendChild(wrap);
