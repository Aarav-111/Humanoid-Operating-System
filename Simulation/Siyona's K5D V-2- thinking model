@dataclass
class MemoryEntry:
    timestamp: float
    kind: str        # "task", "observation", "failure", "success", "goal"
    content: str
    metadata: Dict   = field(default_factory=dict)


class Memory:
    MAX_ENTRIES = 200

    def __init__(self):
        self.entries: List[MemoryEntry] = []
        self.active_goal: Optional[str] = None
        self.active_goal_id: Optional[str] = None
        self.completed_tasks: List[str] = []
        self.failed_attempts: List[Dict] = []
        self.execution_history: List[Dict] = []

    def record(self, kind: str, content: str, metadata: Dict = None):
        self.entries.append(MemoryEntry(
            timestamp=time.time(),
            kind=kind,
            content=content,
            metadata=metadata or {}
        ))
        if len(self.entries) > self.MAX_ENTRIES:
            self.entries = self.entries[-self.MAX_ENTRIES:]

    def set_goal(self, goal: str):
        self.active_goal = goal
        self.active_goal_id = str(uuid.uuid4())[:8]
        self.record("goal", goal)

    def complete_goal(self):
        if self.active_goal:
            self.completed_tasks.append(self.active_goal)
            self.record("success", f"Completed: {self.active_goal}")
        self.active_goal = None
        self.active_goal_id = None

    def fail_goal(self, reason: str):
        if self.active_goal:
            self.failed_attempts.append({
                "goal": self.active_goal,
                "reason": reason,
                "timestamp": time.time()
            })
            self.record("failure", f"Failed '{self.active_goal}': {reason}")
        self.active_goal = None
        self.active_goal_id = None

    def record_action(self, command: str, result: Dict):
        self.execution_history.append({
            "timestamp": time.time(),
            "command": command,
            "result": result
        })
        if len(self.execution_history) > 500:
            self.execution_history = self.execution_history[-500:]

    def context_for_planner(self) -> str:
        lines = []
        if self.active_goal:
            lines.append(f"Active goal: {self.active_goal}")
        if self.completed_tasks:
            lines.append(f"Recently completed: {', '.join(self.completed_tasks[-5:])}")
        if self.failed_attempts:
            recent_fail = self.failed_attempts[-1]
            lines.append(
                f"Last failure: '{recent_fail['goal']}' — {recent_fail['reason']}"
            )
        recent_obs = [e for e in self.entries[-20:] if e.kind == "observation"]
        if recent_obs:
            lines.append("Recent observations: " +
                         "; ".join(e.content for e in recent_obs[-5:]))
        return "\n".join(lines) if lines else "No prior context."

    def recent_failures_for_goal(self) -> int:
        if not self.active_goal:
            return 0
        return sum(1 for f in self.failed_attempts
                   if f.get("goal") == self.active_goal)


